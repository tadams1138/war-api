# Postgres connection string. When set, tests connect to this database instead of
# spinning up a local Testcontainers Postgres.
DATABASE_URL=postgres://war:war@localhost:5432/war_api

# Port the HTTP server listens on.
PORT=3000

# Registered UI origins, comma separated. Used for CORS and the refresh-token
# Origin check (spec §5.1).
UI_ORIGINS=http://localhost:5173

# JWT signing secret (HS256). In production this should be a long random value.
JWT_SECRET=change-me-in-every-real-environment

# Google OAuth application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This API's own public base URL. Used to derive the Google OAuth redirect
# URI (`${PUBLIC_BASE_URL}/api/v1/auth/google/callback`). Optional locally
# (defaults to `http://localhost:${PORT}`); required in a real deployment.
# PUBLIC_BASE_URL=http://localhost:3000

# Shared secret required on the X-Internal-Token header for /internal/* endpoints.
INTERNAL_TASK_TOKEN=change-me-in-every-real-environment

# S3-compatible object storage for contestant media.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=war-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/war-media-dev
